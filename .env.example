# Shared
NODE_ENV=development
LOG_LEVEL=info

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_PUBLIC_BASE_URL=http://localhost:8080
WEB_PUBLIC_BASE_URL=http://localhost:3000
INTERNAL_API_BASE_URL=http://localhost:8080

# Web ops auth
OPS_BASIC_AUTH_USERNAME=ops
OPS_BASIC_AUTH_PASSWORD=change-me-local

# API
API_HOST=0.0.0.0
API_PORT=8080
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_MS=60000
POSTGRES_DB=fourtwo
POSTGRES_USER=fourtwo
POSTGRES_PASSWORD=fourtwo
DATABASE_URL=postgres://fourtwo:fourtwo@localhost:5432/fourtwo
REDIS_URL=redis://localhost:6379
MEMORY_SIDECAR_URL=http://localhost:8090
MEMORY_SIDECAR_API_KEY=replace-with-long-random-value
INSTALLER_BASE_URL=http://localhost:8080/v1/installers
AGENT_ENROLLMENT_SECRET=replace-me
AGENT_ARTIFACTS_DIR=./apps/agent/dist
KNOWLEDGE_ADMIN_API_KEY=replace-with-long-random-value
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Memory sidecar
MEMORY_HOST=0.0.0.0
MEMORY_PORT=8090
MEMORY_PALACE_PATH=/data/palace
MEMORY_BOOTSTRAP_TEXT=4-2.рф memory bootstrap

# Proxy / deploy
SITE_DOMAIN=4-2.рф
SITE_ADDRESS=:80
SITE_HTTP_PORT=80
SITE_HTTPS_PORT=443
